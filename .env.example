# ==========================================
# JobMatchAI - Environment Configuration
# ==========================================

# ==========================================
# REQUIRED - Core API Keys
# ==========================================

# Google Gemini API Key (REQUIRED)
# Get your API key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Session Secret (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_here

# ==========================================
# OPTIONAL - GitHub Integration
# ==========================================

# GitHub Personal Access Token (Optional, but recommended)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
# Generate at: https://github.com/settings/tokens
# Scopes needed: public_repo, read:user
GITHUB_ACCESS_TOKEN=

# GitHub OAuth (for future authentication)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==========================================
# OPTIONAL - External APIs
# ==========================================

# YouTube Data API (for video recommendations)
# Get key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# OpenAI API (alternative to Gemini)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ==========================================
# FUTURE - Database Configuration
# ==========================================

# PostgreSQL Database (Neon recommended)
# Format: postgresql://user:password@host:port/database
# Get Neon DB: https://neon.tech
DATABASE_URL=

# Direct database connection (for migrations)
# Required for Drizzle ORM migrations
DIRECT_URL=

# ==========================================
# FUTURE - Authentication
# ==========================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ==========================================
# SERVER Configuration
# ==========================================

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# RATE LIMITING
# ==========================================

# API Rate Limits (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Gemini API Rate Limits
GEMINI_RATE_LIMIT_RPM=60
GEMINI_RATE_LIMIT_RPD=1500

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable/Disable Features
ENABLE_GITHUB_INTEGRATION=true
ENABLE_RESOURCES_GENERATION=true
ENABLE_AUTO_RESUME_BUILDER=true
ENABLE_ANALYTICS=false

# ==========================================
# LOGGING
# ==========================================

# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Log to File
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/app.log

# ==========================================
# CACHING
# ==========================================

# Cache TTL in seconds
CACHE_TTL=3600

# Redis Configuration (for future use)
REDIS_URL=
REDIS_PASSWORD=

# ==========================================
# EMAIL (for future notifications)
# ==========================================

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@jobmatchai.com

# ==========================================
# ANALYTICS (optional)
# ==========================================

# Google Analytics
GA_TRACKING_ID=

# Mixpanel
MIXPANEL_TOKEN=

# Sentry (Error Tracking)
SENTRY_DSN=

# ==========================================
# STORAGE (for future file uploads)
# ==========================================

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ==========================================
# DEPLOYMENT
# ==========================================

# Vercel
VERCEL_ENV=development

# Domain
DOMAIN=localhost:5173

# ==========================================
# DEVELOPMENT
# ==========================================

# Enable Debug Mode
DEBUG=false

# Mock Data
USE_MOCK_DATA=true

# API Response Delay (ms, for testing)
API_DELAY=0

# ==========================================
# NOTES
# ==========================================

# 1. Copy this file to .env and fill in your values
# 2. Never commit .env to version control
# 3. Generate secrets using: openssl rand -hex 32
# 4. For production, use environment variables in your hosting platform
# 5. Test with: npm run test:env

# ==========================================
# QUICK START COMMANDS
# ==========================================

# Install dependencies:
#   npm install

# Generate session secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Run development server:
#   npm run dev

# Test API endpoints:
#   bash tests/api.test.sh

# Build for production:
#   npm run build

# Deploy to Vercel:
#   vercel --prod